# Desarrollo local — copia este archivo a .env.local:
#   PowerShell: Copy-Item .env.local.example .env.local
#   Bash:       cp .env.local.example .env.local
#
# Completa SUPABASE_SERVICE_ROLE_KEY y DATABASE_URL desde el dashboard de Supabase.
# Arranque: npm run start:dev (puerto 3000). Frontend en http://localhost:5173 con proxy /api.

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Solo el origen del frontend en local (cookies same-origin vía proxy de Vite)
CORS_ORIGINS=http://localhost:5173

# Supabase (proyecto: bvzppyxxwcmhenugfnrj)
SUPABASE_URL=https://bvzppyxxwcmhenugfnrj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Settings → Database → Connection string (pooler, puerto 6543)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# Better Auth — URL que ve el navegador (frontend con proxy, no el puerto 3000)
BETTER_AUTH_URL=http://localhost:5173
# openssl rand -base64 32
BETTER_AUTH_SECRET=dev-local-better-auth-secret-min-32-chars

# Enlaces del portal y verificación en local
APP_VERIFY_BASE_URL=http://localhost:5173
APP_PORTAL_BASE_URL=http://localhost:5173

# Opcionales en desarrollo (recomendado definirlos para probar el portal de firma)
# openssl rand -base64 48
SIGNER_JWT_SECRET=dev-local-signer-jwt-secret-min-32-chars
# openssl rand -base64 32
OTP_PEPPER=dev-local-otp-pepper
TOKEN_PEPPER=dev-local-token-pepper
