# Server
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173,https://proyecto-firma.vercel.app

# Supabase (solo PostgreSQL + Storage; auth vía BetterAuth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL directo (Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# BetterAuth
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# App
APP_VERIFY_BASE_URL=https://proyecto-firma.vercel.app

# Portal de firma (obligatorios en producción)
APP_PORTAL_BASE_URL=https://proyecto-firma.vercel.app
# openssl rand -base64 48
SIGNER_JWT_SECRET=
# openssl rand -base64 32
OTP_PEPPER=
TOKEN_PEPPER=
