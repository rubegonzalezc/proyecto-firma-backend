# Server
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173,https://proyecto-firma.vercel.app

# Supabase (solo PostgreSQL + Storage; auth vía BetterAuth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
APP_VERIFY_BASE_URL=https://proyecto-firma.vercel.app
