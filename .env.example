# Server
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173,https://sign.synchrodev.cl

# Supabase (PostgreSQL + Storage — proyecto: bvzppyxxwcmhenugfnrj)
SUPABASE_URL=https://bvzppyxxwcmhenugfnrj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL directo (Settings → Database → Connection string, pooler 6543)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# Better Auth — URL pública que ve el navegador (en prod: dominio del frontend con proxy /api)
BETTER_AUTH_URL=http://localhost:5173
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# App
APP_VERIFY_BASE_URL=https://sign.synchrodev.cl
APP_PORTAL_BASE_URL=https://sign.synchrodev.cl

# Portal de firma (obligatorios en producción)
# openssl rand -base64 48
SIGNER_JWT_SECRET=
# openssl rand -base64 32
OTP_PEPPER=
TOKEN_PEPPER=
