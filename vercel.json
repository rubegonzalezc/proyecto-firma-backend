{
  "version": 2,
  "buildCommand": "npm run build",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "{dist/**,auth/**,node_modules/better-auth/**,node_modules/better-call/**,node_modules/jose/**,node_modules/nanostores/**}"
    }
  }
}
